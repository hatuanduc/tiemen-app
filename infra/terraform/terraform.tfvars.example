project_id = "your-gcp-project-id"
region     = "asia-southeast1"
artifact_repo = "tiemen"

# Set by CI/CD typically
api_image = "asia-southeast1-docker.pkg.dev/your-gcp-project-id/tiemen/tiemen-api:dev"
web_image = "asia-southeast1-docker.pkg.dev/your-gcp-project-id/tiemen/tiemen-web:dev"

api_env = {
  PORT        = "4000"
  CORS_ORIGIN = "https://your-web-domain"
  JWT_SECRET  = "change-me"
  DEMO_PASSWORD = "admin123"
}
